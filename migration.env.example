# Copy this file to migration.env. Do not commit migration.env.
# This directory must contain the stopped or mounted n8n data volume you intend to preserve.
N8N_DATA_DIR=/srv/n8n-data
# This must be a verified recovery archive created before the migration window.
BACKUP_FILE=/var/backups/n8n/n8n-volume-YYYY-MM-DDTHH-MM-SSZ.tar.gz.age
# Keep this URL in the protected local file. Do not put it in Git.
POSTGRES_URL=postgresql://n8n_app:REPLACE_WITH_PASSWORD@YOUR_CLUSTER_HOST:YOUR_PORT/n8n?sslmode=require
